<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Performance pad: 6 dp radius, 1 dp stroke, tinted per state in code. -->
    <style name="Pad" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">@dimen/pad_sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="strokeColor">@color/border</item>
        <item name="backgroundTint">@color/control</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">@color/border_strong</item>
    </style>

    <!-- Small label: 10 sp caps, muted, tracked. -->
    <style name="Label">
        <item name="android:textSize">@dimen/label_sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Readout: monospace tabular figures. -->
    <style name="Readout">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/readout_sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <!-- The Load screen: a full-screen dialog over the console. -->
    <style name="LoadScreen" parent="Theme.DJMix">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
