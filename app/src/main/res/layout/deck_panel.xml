<?xml version="1.0" encoding="utf-8"?>
<!-- One deck: VOX knob and tempo fader on the outer edge (moved to the right for deck B in code), transport,
     pad-mode tabs, two pad rows. In FX mode the second pad row gives way to ON / DEPTH slider / BEAT. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tempoCol"
        android:layout_width="@dimen/tempo_w"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.prabhat.djmix.ui.KnobView
            android:id="@+id/vox"
            android:layout_width="@dimen/knob"
            android:layout_height="@dimen/knob"
            android:layout_marginBottom="6dp" />

        <com.prabhat.djmix.ui.VFaderView
            android:id="@+id/tempo"
            android:layout_width="@dimen/tempo_w"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTempo"
            style="@style/Readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+0.0%"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvTime"
            style="@style/Readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="0:00\n-0:00"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Transport -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/transport_h"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                style="@style/Pad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_marginEnd="6dp"
                android:text="PLAY"
                android:textSize="13sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCue"
                style="@style/Pad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:layout_marginEnd="6dp"
                android:text="CUE"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/border_strong" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSync"
                style="@style/Pad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="SYNC"
                android:textSize="11sp"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Pad mode tabs, filled in code -->
        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tabs_h"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- Pad bank: two rows of four, filled in code -->
        <LinearLayout
            android:id="@+id/padRow1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/padRow2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- FX mode second row: ON, depth, beat length -->
        <LinearLayout
            android:id="@+id/fxRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFxOn"
                style="@style/Pad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="ON" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_marginEnd="4dp"
                android:background="@drawable/field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depth" />

                <SeekBar
                    android:id="@+id/sbDepth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:splitTrack="false"
                    android:thumb="@drawable/thumb" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBeat"
                style="@style/Pad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="1\nBEAT" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
