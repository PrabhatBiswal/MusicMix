rules_version = '2';

// One shared library for an invited circle. A member (the admin, or a Google account whose verified email is on the
// invite list) reads all of it and adds to it; everyone else, signed in or not, gets nothing. Every upload carries
// metadata.owner = the uploader's uid (CloudRepository.owned); only that member, or the admin, may replace or delete
// it. Files from before sign-in existed have no owner, so only the admin can delete those.
//
// Copy this file to storage.rules and put your own Firebase Auth uid in admin() (Firebase console ->
// Authentication -> Users, after you sign in once in the app).
//
// To invite a friend: add their Google account email, lower case, to the list in invited(), e.g.
//   ['friend.one@gmail.com', 'friend.two@gmail.com']
// then deploy:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.uid in ['YOUR_FIREBASE_UID']; }
    function invited() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [];
    }
    function member() { return admin() || invited(); }
    function owner() { return member() && resource.metadata.get('owner', '') == request.auth.uid; }
    function tagged() { return request.resource.metadata.get('owner', '') == request.auth.uid; }

    match /tracks/{file} {
      allow read: if member();
      allow create: if member() && tagged() && request.resource.size < 100 * 1024 * 1024;
      allow update, delete: if owner() || admin();
    }
    match /mixes/{file} {
      allow read: if member();
      allow create: if member() && tagged() && request.resource.size < 300 * 1024 * 1024;
      allow update, delete: if owner() || admin();
    }
    // Open picks: a small JSON note any member may add, finish (delete) or refresh.
    match /wanted/{file} {
      allow read, delete: if member();
      allow create, update: if member() && request.resource.size < 16 * 1024;
    }
  }
}
